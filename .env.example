DATABASE_URL=postgresql://postgres:password@localhost:5432/eurocars
SESSION_SECRET=

# Keep Blob features disabled until verified with separate test stores.
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_AVATAR_ENABLED=false
BLOB_LISTING_ENABLED=false

# Limits and output dimensions for Blob image processing.
IMAGE_MAX_FILE_SIZE_MB=10
IMAGE_MAX_COUNT=20
IMAGE_MAX_WIDTH=1920
IMAGE_WEBP_QUALITY=82
IMAGE_THUMBNAIL_WIDTH=320
IMAGE_CATALOG_WIDTH=640
IMAGE_AVATAR_SIZE=256
